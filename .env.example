# ==================================================
# BASE DE DATOS (PostgreSQL)
# ==================================================
# Para desarrollo local, puedes usar PostgreSQL local o servicios gratuitos:
# - Neon: https://neon.tech (gratis)
# - Supabase: https://supabase.com (gratis)
# - Railway: https://railway.app (gratis con límites)
DATABASE_URL="postgresql://user:password@localhost:5432/bitax"

# ==================================================
# NEXTAUTH (Autenticación)
# ==================================================
# URL de tu aplicación
NEXTAUTH_URL="http://localhost:3000"

# Secret para firmar tokens JWT (generar con: openssl rand -base64 32)
NEXTAUTH_SECRET="tu-secret-key-super-segura-aqui-cambiar-en-produccion"

# ==================================================
# STRIPE (Pagos y Suscripciones)
# ==================================================
# Keys de Stripe (obtener en: https://dashboard.stripe.com/apikeys)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."

# Webhook secret para eventos de Stripe
STRIPE_WEBHOOK_SECRET="whsec_..."

# ID del precio de la suscripción premium (crear en Stripe Dashboard)
STRIPE_PREMIUM_PRICE_ID="price_..."

# ==================================================
# EMAIL (Opcional - para recordatorios)
# ==================================================
# SMTP para enviar emails
# EMAIL_SERVER_HOST="smtp.gmail.com"
# EMAIL_SERVER_PORT="587"
# EMAIL_SERVER_USER="tu-email@gmail.com"
# EMAIL_SERVER_PASSWORD="tu-app-password"
# EMAIL_FROM="BiTax <noreply@bitax.com>"

# ==================================================
# OTROS
# ==================================================
# Entorno
NODE_ENV="development"

# URL pública de la app (para emails, webhooks, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
